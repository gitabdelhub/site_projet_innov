# URL of the Flask Elo API (Render in production, local in plan B).
# Leave empty: the site then uses the model directly in the browser.
VITE_API_URL=http://localhost:5000

# Optional: Supabase (accounts and online play only). Leave empty to disable.
# Setup step by step: docs/MODE_EN_LIGNE.md (in Vercel, set them for Production and Preview).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
