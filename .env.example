VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server only (used by /api/move to check online moves). Supabase: Project Settings > API > service_role.
# Never prefix it with VITE_: it must not reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional, server only: turns on the AI teacher (/api/coach). Free key at https://console.groq.com/keys
GROQ_API_KEY=
