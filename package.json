{
  "name": "chess-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "local": "node scripts/start-local.mjs",
    "api": "python ml_backend/app.py",
    "eval:elo": "esbuild scripts/eval-elo-model.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/eval-elo.mjs && node node_modules/.cache/eval-elo.mjs",
    "calibrate:elo": "esbuild scripts/calibrate-elo-features.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/calibrate-elo.mjs && node node_modules/.cache/calibrate-elo.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "chess.js": "^1.0.0-beta.8",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
